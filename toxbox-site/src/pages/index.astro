---
import thumbnail from "../assets/thumbnail.webp";
import "../styles/landing.css";

const boothUrl = "https://simijimishijimi.booth.pm/items/7592348";
const base = import.meta.env.BASE_URL;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>TOXBOX - TouchDesigner VJ Tool</title>
    <meta
      name="description"
      content="TOXBOX - TouchDesignerで作ったtoxをそのままライブ演出に。4レイヤー合成、オーディオ解析、BPMシーケンサー、MIDIマッピングを統合したVJツール。"
    />
    <link rel="icon" href={`${base}favicon.svg`} />
  </head>
  <body>
    <!-- Header -->
    <header class="header">
      <a href={base}>
        <img class="header-logo" src={`${base}logo-dark.svg`} alt="TOXBOX" />
      </a>
      <nav class="header-nav">
        <div class="header-links">
          <a class="header-link active" href={base}>ホーム</a>
          <a class="header-link" href={`${base}docs/welcome/`}>ドキュメント</a>
          <a class="header-link" href={`${base}docs/releases/`}>リリースノート</a>
        </div>
        <a class="header-cta header-booth" href={boothUrl} target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M18 6h-2c0-2.21-1.79-4-4-4S8 3.79 8 6H6c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-6-2c1.1 0 2 .9 2 2h-4c0-1.1.9-2 2-2zm6 16H6V8h2v2c0 .55.45 1 1 1s1-.45 1-1V8h4v2c0 .55.45 1 1 1s1-.45 1-1V8h2v12z"/></svg>
          <span>BOOTHで入手</span>
        </a>
      </nav>
    </header>

    <main>
      <!-- Hero -->
      <section class="hero">
        <div class="hero-bg">
          <video autoplay muted loop playsinline poster={thumbnail.src}>
            <source src="/hero-video.webm" type="video/webm" />
            <img src={thumbnail.src} alt="" />
          </video>
        </div>
        <div class="hero-content">
          <div class="hero-badge">
            VJ Tool for TouchDesigner
          </div>
          <h1>あなたの作品を<br />今夜のステージへ</h1>
          <p class="hero-lead">
            ドラッグ&ドロップでシーンを読み込み オーディオ・BPM・MIDIと連動<br />
            TouchDesignerの作品が そのままライブ演出に
          </p>
          <div class="hero-actions">
            <a class="btn btn-lg btn-booth" href={boothUrl} target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M18 6h-2c0-2.21-1.79-4-4-4S8 3.79 8 6H6c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-6-2c1.1 0 2 .9 2 2h-4c0-1.1.9-2 2-2zm6 16H6V8h2v2c0 .55.45 1 1 1s1-.45 1-1V8h4v2c0 .55.45 1 1 1s1-.45 1-1V8h2v12z"/></svg>
              BOOTHで入手
            </a>
            <a class="btn btn-secondary" href={`${base}docs/welcome/`}>
              <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor"><path d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm4 18H6V4h7v5h5v11z"/></svg>
              ドキュメント
            </a>
          </div>
        </div>
      </section>

      <!-- About -->
      <section class="about" id="about">
        <p class="section-label">What is TOXBOX</p>
        <h2 class="about-title">
          <img class="about-title-logo" src={`${base}logo-dark.svg`} alt="TOXBOX" />
          is VJ Tool for TouchDesigner
        </h2>
        <p class="about-desc">
          TOXBOXは、<strong>あなたのtoxファイルをそのまま読み込み</strong>、
          VJパフォーマンスに必要な機能を提供するTouchDesigner製ツールです。<br />
          オーディオ解析やBPM同期、MIDIコントロールなど、
          <strong>現場で求められる機能をひとつに統合</strong>。<br />
          作品作りに集中しながら、すぐにステージへ持ち出せる環境を実現します。
        </p>
      </section>

      <!-- Features -->
      <section class="features" id="features">
        <p class="section-label">Features</p>
        <h2 class="section-title">VJに必要なすべてを、ひとつに。</h2>
        <div class="features-grid">
          <div class="feature-card">
            <div class="feature-icon"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M20 2H4c-1 0-2 .9-2 2v3.01c0 .72.43 1.34 1 1.69V20c0 1.1 1.1 2 2 2h14c.9 0 2-.9 2-2V8.7c.57-.35 1-.97 1-1.69V4c0-1.1-1-2-2-2zm-5 12H9v-2h6v2zm5-7H4V4l16-.02V7z"/></svg></div>
            <h3 class="feature-title">tox 読み込み</h3>
            <p class="feature-desc">既存シーンをドラッグ&ドロップで取り込み、すぐにスタート。</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M11.99 18.54l-7.37-5.73L3 14.07l9 7 9-7-1.63-1.27-7.38 5.74zM12 16l7.36-5.73L21 9l-9-7-9 7 1.63 1.27L12 16z"/></svg></div>
            <h3 class="feature-title">4レイヤー / 32シーン</h3>
            <p class="feature-desc">フェーダーで素早く合成。直感的なレイヤーミックス。</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M7 18h2V6H7v12zm4 4h2V2h-2v20zm-8-8h2v-4H3v4zm12 4h2V6h-2v12zm4-8v4h2v-4h-2z"/></svg></div>
            <h3 class="feature-title">Audio Analysis</h3>
            <p class="feature-desc">Low / High / Peak を解析し、パラメータへ即座に反映。</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M15 1H9v2h6V1zm-4 13h2V8h-2v6zm8.03-6.61l1.42-1.42c-.43-.51-.9-.99-1.41-1.41l-1.42 1.42C16.07 4.74 14.12 4 12 4c-4.97 0-9 4.03-9 9s4.02 9 9 9 9-4.03 9-9c0-2.12-.74-4.07-1.97-5.61zM12 20c-3.87 0-7-3.13-7-7s3.13-7 7-7 7 3.13 7 7-3.13 7-7 7z"/></svg></div>
            <h3 class="feature-title">BPM Sequencer</h3>
            <p class="feature-desc">BPM連動の信号生成で、動きの骨格を作る。</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z"/></svg></div>
            <h3 class="feature-title">MIDI Mapping</h3>
            <p class="feature-desc">お気に入りのコントローラーで指先操作。</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M19 9l1.25-2.75L23 5l-2.75-1.25L19 1l-1.25 2.75L15 5l2.75 1.25L19 9zm-7.5.5L9 4 6.5 9.5 1 12l5.5 2.5L9 20l2.5-5.5L17 12l-5.5-2.5zM19 15l-1.25 2.75L15 19l2.75 1.25L19 23l1.25-2.75L23 19l-2.75-1.25L19 15z"/></svg></div>
            <h3 class="feature-title">Post FX × 8</h3>
            <p class="feature-desc">豊富なエフェクトで仕上げまで完結。</p>
          </div>
        </div>
      </section>

      <!-- Video -->
      <section class="video-section" id="video">
        <p class="section-label">Demo</p>
        <h2 class="section-title">3分でわかるTOXBOX</h2>
        <div class="video-wrapper">
          <iframe
            src="https://www.youtube-nocookie.com/embed/SHeJOBs7QTI?rel=0"
            title="TOXBOX 紹介動画"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
          ></iframe>
        </div>
      </section>

      <!-- CTA -->
      <section class="cta">
        <div class="cta-inner">
          <h2>今夜のライブに、TOXBOXを。</h2>
          <p class="cta-desc">買い切り・無料アップデート対応</p>
          <p class="cta-requirement">TouchDesigner 2025.32050 以降で動作</p>
          <a class="btn btn-booth" href={boothUrl} target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M18 6h-2c0-2.21-1.79-4-4-4S8 3.79 8 6H6c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-6-2c1.1 0 2 .9 2 2h-4c0-1.1.9-2 2-2zm6 16H6V8h2v2c0 .55.45 1 1 1s1-.45 1-1V8h4v2c0 .55.45 1 1 1s1-.45 1-1V8h2v12z"/></svg>
            BOOTHで入手
          </a>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer class="footer">
      <div class="footer-left">
        <img class="footer-logo" src={`${base}logo-dark.svg`} alt="TOXBOX" />
        <div class="footer-links">
          <a class="footer-link" href={`${base}docs/welcome/`}>Docs</a>
          <a class="footer-link" href={`${base}docs/troubleshooting/`}>Troubleshooting</a>
        </div>
      </div>
      <p class="footer-copy">© TOXBOX</p>
    </footer>
  </body>
</html>
